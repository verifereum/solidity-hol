{
  "name": "memory_structs",
  "source": "testdata/differential/memory_structs.sol",
  "contract": "MemoryStructs",
  "artifact": "testdata/differential/expected/memory_structs.json",
  "cases": [
    {
      "name": "positional",
      "function": "positional",
      "args": [
        7,
        -3
      ],
      "storage": {},
      "expect": {
        "return": [
          7,
          -3
        ]
      }
    },
    {
      "name": "named_arguments",
      "function": "named",
      "args": [
        7,
        -3
      ],
      "storage": {},
      "expect": {
        "return": [
          8,
          -5
        ]
      }
    },
    {
      "name": "named_field_overflow",
      "function": "named",
      "args": [
        "18446744073709551615",
        0
      ],
      "storage": {},
      "expect": {
        "panic": "0x11"
      }
    },
    {
      "name": "zeroed_local",
      "function": "zeroed",
      "args": [],
      "storage": {},
      "expect": {
        "return": [
          0,
          0,
          0,
          0,
          0,
          0
        ]
      }
    },
    {
      "name": "field_aliasing",
      "function": "aliasing",
      "args": [
        10
      ],
      "storage": {},
      "expect": {
        "return": [
          16,
          16,
          16
        ]
      }
    },
    {
      "name": "struct_array",
      "function": "array",
      "args": [
        3,
        1
      ],
      "storage": {},
      "expect": {
        "return": [
          9,
          -4,
          3
        ]
      }
    },
    {
      "name": "struct_array_out_of_bounds",
      "function": "array",
      "args": [
        2,
        5
      ],
      "storage": {},
      "expect": {
        "panic": "0x32"
      }
    },
    {
      "name": "named_argument_order",
      "function": "order",
      "args": [
        4
      ],
      "storage": {},
      "expect": {
        "return": [
          5,
          4
        ]
      }
    },
    {
      "name": "memory_to_storage",
      "function": "toStorage",
      "args": [
        7,
        1286
      ],
      "storage": {
        "0": "0xff000000"
      },
      "expect": {
        "return": [
          7,
          1286
        ]
      },
      "final_storage": {
        "0": "0xff050607"
      }
    },
    {
      "name": "storage_to_memory",
      "function": "fromStorage",
      "args": [],
      "storage": {
        "0": "0xff050607"
      },
      "expect": {
        "return": [
          7,
          1286
        ]
      },
      "final_storage": {
        "0": "0xff050607"
      }
    },
    {
      "name": "storage_copy_is_a_snapshot",
      "function": "snapshot",
      "args": [
        9
      ],
      "storage": {
        "0": "0x0102"
      },
      "expect": {
        "return": [
          2,
          9
        ]
      },
      "final_storage": {
        "0": "0x0109"
      }
    },
    {
      "name": "internal_parameters_and_returns",
      "function": "passing",
      "args": [
        5
      ],
      "storage": {},
      "expect": {
        "return": [
          10,
          11
        ]
      }
    },
    {
      "name": "constructor_with_reference_fields",
      "function": "withBytes",
      "args": [
        7
      ],
      "storage": {},
      "expect": {
        "return": [
          3,
          12,
          300
        ]
      }
    },
    {
      "name": "paint_copy",
      "function": "paintCopy",
      "args": [],
      "storage": {
        "1": 257
      },
      "expect": {
        "return": [
          1
        ]
      }
    },
    {
      "name": "paint_copy_bad_enum",
      "function": "paintCopy",
      "args": [],
      "storage": {
        "1": 5
      },
      "expect": {
        "panic": "0x21"
      }
    }
  ]
}
