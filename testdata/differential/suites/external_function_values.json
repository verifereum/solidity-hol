        20480,
        5
      ],
      "expect": {
        "return": [
          7,
          20480,
          "0xed1bd76c",
          15,
          9
        ]
      },
      "final_storage": {
        "0": "14462442398330912479877658831070463422699826966564152028916743"
      }
