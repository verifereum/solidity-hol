{
  "name": "memory_arrays",
  "source": "testdata/differential/memory_arrays.sol",
  "contract": "MemoryArrays",
  "artifact": "testdata/differential/expected/memory_arrays.json",
  "cases": [
    {
      "name": "dynamic_write_read",
      "function": "dynamicWriteRead",
      "args": [
        3,
        1,
        7
      ],
      "expect": {
        "return": [
          3,
          7
        ]
      }
    },
    {
      "name": "dynamic_index_at_length_panics",
      "function": "dynamicWriteRead",
      "args": [
        3,
        3,
        7
      ],
      "expect": {
        "panic": "0x32"
      }
    },
    {
      "name": "dynamic_empty_index_panics",
      "function": "dynamicWriteRead",
      "args": [
        0,
        0,
        7
      ],
      "expect": {
        "panic": "0x32"
      }
    },
    {
      "name": "new_length_2_64_panics",
      "function": "dynamicWriteRead",
      "args": [
        18446744073709551616,
        0,
        0
      ],
      "expect": {
        "panic": "0x41"
      }
    },
    {
      "name": "new_huge_length_panics",
      "function": "dynamicWriteRead",
      "args": [
        115792089237316195423570985008687907853269984665640564039457584007913129639935,
        0,
        0
      ],
      "expect": {
        "panic": "0x41"
      }
    },
    {
      "name": "new_allocation_overflow_panics",
      "function": "dynamicWriteRead",
      "args": [
        576460752303423488,
        0,
        0
      ],
      "expect": {
        "panic": "0x41"
      }
    },
    {
      "name": "static_default_written",
      "function": "staticDefault",
      "args": [
        1
      ],
      "expect": {
        "return": [
          5,
          3
        ]
      }
    },
    {
      "name": "static_default_zero",
      "function": "staticDefault",
      "args": [
        0
      ],
      "expect": {
        "return": [
          0,
          3
        ]
      }
    },
    {
      "name": "static_index_at_length_panics",
      "function": "staticDefault",
      "args": [
        3
      ],
      "expect": {
        "panic": "0x32"
      }
    },
    {
      "name": "assignment_aliases_and_rebinds",
      "function": "aliasing",
      "args": [
        200
      ],
      "expect": {
        "return": [
          200,
          9
        ]
      }
    },
    {
      "name": "nested_dynamic_default_is_empty",
      "function": "nestedDynamic",
      "args": [
        0
      ],
      "expect": {
        "return": [
          0,
