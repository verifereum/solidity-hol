          144
        ]
      }
    },
    {
      "name": "constant_as_modifier_argument",
      "function": "capped",
      "args": [
        5
      ],
      "expect": {
        "return": [
          5
        ]
      }
    },
    {
      "name": "constant_as_modifier_argument_reverts",
      "function": "capped",
      "args": [
        20
      ],
      "expect": {
        "revert": "0x"
      }
