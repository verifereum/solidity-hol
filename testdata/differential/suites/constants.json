{
  "name": "constants",
  "source": "testdata/differential/constants.sol",
  "contract": "Constants",
  "artifact": "testdata/differential/expected/constants.json",
  "cases": [
    {
      "name": "initializer_and_base_argument_read_constants",
      "deploy": true,
      "args": [],
      "expect": {
        "return": []
      },
      "final_storage": {
        "0": "36",
        "1": "3000000000000000000000000000"
      }
    },
    {
      "name": "folded_and_derived_constants",
      "function": "rmul",
      "args": [
        2000000000000000000000000000,
        3000000000000000000000000000
      ],
      "expect": {
        "return": [
          6000000000000000000000000000
        ]
      }
    },
    {
      "name": "derived_constant_rounds",
      "function": "rmul",
      "args": [
        1,
        1
      ],
      "expect": {
        "return": [
          0
        ]
      }
    },
    {
      "name": "operands_overflow_with_constants",
      "function": "rmul",
      "args": [
        57896044618658097711785492504343953926634992332820282019728792003956564819968,
        2
      ],
      "expect": {
        "panic": "0x11"
      }
    },
    {
      "name": "constant_value_overflows_when_referenced",
      "function": "overflows",
      "args": [],
      "expect": {
        "panic": "0x11"
      }
    },
    {
      "name": "constant_value_wraps_in_unchecked_code",
      "function": "wraps",
      "args": [],
