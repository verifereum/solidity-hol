        "content": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.37;\n\n// Dispatch with only receive: it runs on empty calldata, and anything else\n// reverts.\ncontract ReceiveOnly {\n    uint256 private received;\n\n    receive() external payable {\n        received += msg.value;\n    }\n}\n"
